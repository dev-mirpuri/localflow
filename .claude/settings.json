{
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *rulesets*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh api *rulesets*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\""
          }
        ]
      }
    ]
  }
}
