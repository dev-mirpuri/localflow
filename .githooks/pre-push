#!/bin/sh
# Refuse any push whose remote ref is main. Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push $local_ref to refs/heads/main." >&2
    echo "Push to dev or a ticket branch, then open a pull request." >&2
    exit 1
  fi
done
